# =====================================================
# RentFlow - Environment Variables Example
# Sao chép file này thành .env và điền giá trị thực
# =====================================================

# Server settings
HOST=127.0.0.1
PORT=8000

# Tạo SECRET_KEY bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Tài khoản admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# Database
# Dev cục bộ: để trống / dùng SQLite. Production (Vercel): đặt DATABASE_URL trỏ
# tới Postgres, ví dụ Neon: postgresql://user:pass@host/db?sslmode=require
SQLALCHEMY_DATABASE_URL=sqlite:///./rentflow.db
# DATABASE_URL=

# Production: tắt seed dữ liệu mẫu để không chèn 12 phòng giả vào DB thật
# SEED_SAMPLE_DATA=false

# Production: ENVIRONMENT=production bật cookie secure (yêu cầu HTTPS — Vercel có sẵn)
# ENVIRONMENT=production

# Thông tin ngân hàng (tuỳ chọn)
BANK_NAME=MB
BANK_ACCOUNT=
ACCOUNT_HOLDER=
